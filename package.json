{
	"name": "signmos",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"prepare": "simple-git-hooks",
		"init-project": "tsx scripts/init-project.ts",
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"deploy": "ohmyhost deploy",
		"serve": "vite preview",
		"cf-typegen": "wrangler types --env-interface BaseEnv",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"agentic:calibrate": "node --import tsx scripts/agentic-calibrate.ts",
		"agentic:smoke": "node --import tsx scripts/agentic-smoke.ts",
		"types": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:ci": "biome ci .",
		"knip": "knip",
		"release": "semantic-release",
		"release:dry": "semantic-release --dry-run",
		"deps": "taze -r",
		"deps:update": "taze -r -w",
		"deps:major": "taze -r major",
		"deps:major:update": "taze -r major -w",
		"db:generate:dev": "dotenvx run -f .dev.vars -- drizzle-kit generate --config drizzle-dev.config.ts",
		"db:generate:staging": "dotenvx run -f .staging.vars -- drizzle-kit generate --config drizzle-staging.config.ts",
		"db:generate:production": "dotenvx run -f .production.vars -- drizzle-kit generate --config drizzle-production.config.ts",
		"omh:check": "ohmyhost init --dry-run --region eu --json",
		"omh:output": "node --import tsx scripts/check-omh-output.ts"
	},
	"dependencies": {
		"@ohmyhost/customer-runtime": "npm:@amerged/ohmyhost-runtime@0.1.36",
		"@radix-ui/react-collapsible": "^1.1.20",
		"@radix-ui/react-dialog": "^1.1.23",
		"@radix-ui/react-dropdown-menu": "^2.1.24",
		"@radix-ui/react-slot": "^1.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/react-form": "^1.33.4",
		"@tanstack/react-query": "^5.104.5",
		"@tanstack/react-query-devtools": "^5.104.5",
		"@tanstack/react-router": "^1.170.45",
		"@tanstack/react-router-devtools": "^1.167.2",
		"@tanstack/react-router-ssr-query": "^1.167.3",
		"@tanstack/react-start": "1.169.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.13.11",
		"lucide-react": "^1.30.0",
		"pdf-lib": "^1.17.1",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^6.1.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.4",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@dotenvx/dotenvx": "^2.20.1",
		"@electric-sql/pglite": "0.5.10",
		"@semantic-release/changelog": "^6.0.3",
		"@semantic-release/git": "^10.0.1",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.2",
		"@vitest/coverage-v8": "^4.1.11",
		"drizzle-kit": "^0.31.10",
		"jsdom": "^29.1.1",
		"knip": "^6.32.0",
		"semantic-release": "^25.0.9",
		"simple-git-hooks": "^2.13.1",
		"taze": "^19.17.2",
		"tsx": "^4.23.11",
		"typescript": "^5.9.3",
		"vite": "^8.2.4",
		"vitest": "^4.1.11",
		"web-vitals": "^5.3.0",
		"wrangler": "^4.151.0"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm run lint:ci",
		"pre-push": "pnpm run types && pnpm run knip"
	}
}
